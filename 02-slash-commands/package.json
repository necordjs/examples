{
	"name": "02-slash-commands",
	"version": "1.0.0",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"format": "prettier --write \"src/**/*.ts\"",
		"start": "npm run build && node dist/main.js",
		"prestart:dev": "npm run build",
		"start:dev": "concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/main.js\"",
		"prestart:debug": "npm run build",
		"start:debug": "concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --inspect --watch --watch-preserve-output dist/main.js\"",
		"start:prod": "node dist/main.js",
		"lint": "oxlint --type-aware --deny-warnings src"
	},
	"dependencies": {
		"@nestjs/common": "12.0.1",
		"@nestjs/core": "12.0.1",
		"discord.js": "14.27.0",
		"necord": "7.0.0",
		"reflect-metadata": "0.2.2",
		"rimraf": "6.1.3",
		"rxjs": "7.8.2"
	},
	"devDependencies": {
		"@types/node": "26.4.1",
		"concurrently": "10.0.5",
		"eslint": "^10.0.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-prettier": "5.5.6",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.6.0"
	}
}
